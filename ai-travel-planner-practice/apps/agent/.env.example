# --- Development (OpenRouter — free/cheap models) ---
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key
DEV_LLM_MODEL=openrouter/google/gemini-2.0-flash-exp:free
# DEV_JUDGE_MODEL=openrouter/google/gemini-2.0-flash-exp:free

# --- Production (set on host only, NODE_ENV=production) ---
# OPENAI_API_KEY=your-openai-key
# LLM_MODEL=openai/gpt-4o-mini
# JUDGE_MODEL=openai/gpt-4o-mini

# Mastra Observability — https://projects.mastra.ai
MASTRA_PLATFORM_ACCESS_TOKEN=your-token
MASTRA_PROJECT_ID=your-project-id
